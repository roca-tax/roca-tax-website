:root{--primary-color:#0a4a95;--text-color:#000000;--border-color:#bdc3c7}body{font-family:segoe ui,roboto,open sans,-apple-system,BlinkMacSystemFont,helvetica neue,Arial,sans-serif;line-height:1.6;color:var(--text-color);background-color:#fff}h1,h2,h3,h4,h5,h6{font-family:segoe ui,roboto,open sans,-apple-system,BlinkMacSystemFont,helvetica neue,Arial,sans-serif;font-weight:600;color:var(--primary-color)}main h1{font-size:2.25rem;margin-bottom:1.5rem}main p{font-size:1.15rem;color:#444}footer{border-color:var(--border-color)!important}a{color:var(--primary-color)}